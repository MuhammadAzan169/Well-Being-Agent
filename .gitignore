# ── Secrets ───────────────────────────────────────────────────────────
# Never commit real credentials. Use .env.example as the tracked template.
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.Python
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# ── Backend runtime (ephemeral: cache, conversation log, recordings,
#    downloaded model weights) ──────────────────────────────────────────
backend/var/
var/

# ── Frontend ──────────────────────────────────────────────────────────
node_modules/
.vercel/
# Generated at build time by build.mjs (Vercel) or app.py (local).
frontend/js/config.js

# ── Model caches ──────────────────────────────────────────────────────
.cache/
fastembed-cache/
.huggingface/

# ── Tooling ───────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.log

# ── Editors / OS ──────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
