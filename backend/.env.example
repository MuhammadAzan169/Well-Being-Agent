# ── WellBeing Agent — Backend Environment ─────────────────────────────
# Copy to .env and fill in real values:  cp .env.example .env
# NEVER commit .env. On Render, set these in the dashboard instead.

# ── App ───────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | production
PORT=8000
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated frontend origins, no trailing slash. Use * to allow any
# origin (safe here: the API sends no credentials).
# In production set this to your Vercel domain.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# ── LLM (OpenAI-compatible, e.g. OpenRouter) ──────────────────────────
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.3
LLM_TIMEOUT_SECONDS=60
# Upper bound on the whole key/model retry sweep, so a total provider
# outage returns the fallback message instead of hanging the request.
LLM_TOTAL_TIMEOUT_SECONDS=120

# API keys — at least one is required. Get one at https://openrouter.ai/keys
#
# Preferred: numbered keys. Every OPENROUTER_API_KEY<N> is discovered in
# order and tried in turn, so extra keys give you automatic failover when
# one is rate limited.
OPENROUTER_API_KEY1=your-api-key-here
# OPENROUTER_API_KEY2=
# OPENROUTER_API_KEY3=

# Fallback: a single key, used only when no numbered keys are present.
# LLM_API_KEY=your-api-key-here

# Models — an ordered fallback chain. Every key is tried against each model
# before moving to the next model. A model returning 400/404 is skipped.
OPENROUTER_MODEL_1=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_2=minimax/minimax-m3:free
# OPENROUTER_MODEL_3=z-ai/glm-5.2:free

# Fallback single model, used only when no OPENROUTER_MODEL_<N> are present.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# ── Embeddings / Index ────────────────────────────────────────────────
# Runs locally through fastembed (ONNX) in BOTH environments — no PyTorch,
# ~50 MB RAM, so it fits the Render free plan.
# MUST match the model the persisted index was built with. If they disagree,
# the app logs a warning and uses the index's own model; rebuild with
#   python -m scripts.build_index
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Paths are relative to the backend/ directory unless absolute.
INDEX_PATH=data/cancer_index_store
DATASET_PATH=data/DataSet/breast_cancer_comprehensive.json
SIMILARITY_TOP_K=5
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── Cache ─────────────────────────────────────────────────────────────
CACHE_TTL_HOURS=24
CACHE_SIMILARITY_THRESHOLD=0.85
# Size caps — both files are rewritten in full each turn, so these bound
# memory and latency on a small instance.
CACHE_MAX_ENTRIES=500
CONVERSATION_LOG_MAX_ENTRIES=1000

# ── Voice (faster-whisper) — LOCAL ONLY ───────────────────────────────
# Does NOT fit the Render free plan: keep ENABLE_VOICE=false in production,
# where the frontend falls back to the browser's Web Speech API.
# To enable locally:  pip install -r requirements-voice.txt
ENABLE_VOICE=false
WHISPER_MODEL_ID=small             # small (~500 MB) | base (~150 MB)
MAX_AUDIO_SIZE_MB=10
MAX_QUERY_LENGTH=2000

# ── Runtime (writable) directory ──────────────────────────────────────
# Holds cache, conversation log, recordings, and the embedding model cache.
# Relative to backend/. Ephemeral on Render.
RUNTIME_DIR=var

# ── Single-core tuning (set these on Render) ──────────────────────────
# OMP_NUM_THREADS=1
# MKL_NUM_THREADS=1
# TOKENIZERS_PARALLELISM=false
# FASTEMBED_CACHE_PATH=/opt/render/project/src/backend/var/fastembed-cache
