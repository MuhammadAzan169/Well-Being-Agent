# ── WellBeing Agent — Frontend Environment ────────────────────────────
# Copy to .env for local development. On Vercel, set this in
# Project → Settings → Environment Variables (all environments).
#
# It is baked into js/config.js at build time by build.mjs.

# Base URL of the backend API, with NO trailing slash.
#   Local  : http://localhost:8000   (what `python app.py` starts)
#   Vercel : https://<your-service>.onrender.com
API_BASE_URL=http://localhost:8000
